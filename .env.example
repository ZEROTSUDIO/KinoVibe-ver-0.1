# KinoVibe v0.2 Environment Variables

# Public Supabase credentials (used by client via Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret TMDB API key (used by serverless proxy & Vite dev server only - NEVER exposed to browser)
TMDB_API_KEY=your_tmdb_api_key_here
