{
  "name": "kinovibe",
  "version": "0.2.0",
  "private": true,
  "description": "KinoVibe - Personal Movie Review & Vibe Library with Tailwind CSS",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./style.css --minify",
